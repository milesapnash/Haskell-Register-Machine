cabal-version: 2.4
name:          haskell-register-machine
version:       0.1.0.0
synopsis:      A register machine simulator with program encoding/decoding
license:       MIT

library
  exposed-modules:
    Pairing
    Programs
    RegisterMachine
  build-depends:
    base  >= 4.14 && < 5,
    array >= 0.5  && < 1
  default-language: Haskell2010

test-suite tests
  type:            exitcode-stdio-1.0
  main-is:         Test.hs
  build-depends:
    base  >= 4.14 && < 5,
    array >= 0.5  && < 1,
    haskell-register-machine
  default-language: Haskell2010
